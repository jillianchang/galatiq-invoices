# Copy to .env and fill in LLM_API_KEY.

# Development: Groq free tier (gpt-oss models). https://console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b        # strong tier: approval, critic
LLM_MODEL_FAST=openai/gpt-oss-20b    # fast tier: extraction, investigator

# Final runs: xAI Grok (uncomment and replace the block above)
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=grok-4.7
# LLM_MODEL_FAST=grok-4.7

# replay = cache only (no key needed) | record = cache first, call on miss, save | live = always call
# Default: record if LLM_API_KEY is set, otherwise replay.
# LLM_MODE=record
# LLM_CACHE_DIR=evals/llm_cache
